# Smart School Git Ignore
# CodeCanyon Product - Configured for fresh installation capability

# ====================
# Environment & System Files
# ====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

# ====================
# IDE & Editor Files
# ====================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/
.project
.buildpath
.settings/

# ====================
# Installation-Generated Config Files
# ====================
# Database config is CREATED during installation, not tracked
smart_school_src/application/config/database.php

# NOTE: config.php and autoload.php ARE TRACKED in pre-install state
# After running installer, these files will be modified locally:
# - config.php: installed = false → true
# - autoload.php: minimal libraries → full libraries
# These local modifications should NOT be committed back to git
# Use: git update-index --skip-worktree <file> to ignore local changes

# Any local configuration overrides
smart_school_src/application/config/local.php
smart_school_src/application/config/*_local.php

# ====================
# Runtime & Generated Files
# ====================
# Application logs (keep folder structure, exclude log files)
smart_school_src/application/logs/*
!smart_school_src/application/logs/index.html
!smart_school_src/application/logs/.gitkeep

# Backup directory (exclude all backup files)
smart_school_src/backup/*
!smart_school_src/backup/.gitkeep
!smart_school_src/backup/index.html

# Temporary files
smart_school_src/temp/*
!smart_school_src/temp/.gitkeep
!smart_school_src/temp/index.html

# Generated captcha images
smart_school_src/backend/captcha_images/*.jpg
smart_school_src/backend/captcha_images/*.png
!smart_school_src/backend/captcha_images/.gitkeep

# Cache files
smart_school_src/application/cache/*
!smart_school_src/application/cache/index.html
!smart_school_src/application/cache/.gitkeep

# ====================
# User Uploads (Exclude user data, KEEP core/default assets)
# ====================
# Exclude everything in uploads first
smart_school_src/uploads/*

# Then INCLUDE the uploads directory structure and core assets
!smart_school_src/uploads/.gitkeep
!smart_school_src/uploads/index.html

# INCLUDE: Core placeholder images
!smart_school_src/uploads/no_image.png

